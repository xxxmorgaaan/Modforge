# Скопируйте этот файл в .env и заполните значения перед запуском

# Порт, на котором будет работать сервер
PORT=3000

# Секрет для подписи сессионных cookie админки — впишите длинную случайную строку
SESSION_SECRET=change-me-to-a-long-random-string

# Логин и пароль главного админа.
# Пароль будет захеширован и сохранён в базе при первом запуске (или через npm run create-admin).
# После первого запуска можно менять пароль прямо из панели администратора —
# эти переменные используются только для самой первой инициализации.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Максимальный размер файла мода в мегабайтах
MAX_MOD_FILE_MB=1024

# Максимальный размер одного изображения (обложка/скриншот) в мегабайтах
MAX_IMAGE_MB=15

# Ставьте true, если сайт работает по HTTPS (за nginx с сертификатом) —
# тогда cookie сессии админки будут отправляться только по защищённому соединению
COOKIE_SECURE=false
