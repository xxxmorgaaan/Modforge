# Пример конфига Nginx как обратного прокси перед Node.js-приложением.
# Скопируйте в /etc/nginx/sites-available/modforge, поправьте домен и пути,
# затем: ln -s /etc/nginx/sites-available/modforge /etc/nginx/sites-enabled/
# и sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name your-domain.example;

    # Разрешаем загрузку крупных файлов модов (подстройте под MAX_MOD_FILE_MB из .env)
    client_max_body_size 1100m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# После настройки HTTPS через certbot (рекомендуется):
#   sudo certbot --nginx -d your-domain.example
# не забудьте поставить COOKIE_SECURE=true в .env, чтобы cookie админки
# передавались только по защищённому соединению.
